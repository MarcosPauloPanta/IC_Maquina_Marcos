// ============================================================
// CONTROLADOR DE MOTORES - CNC SHIELD V3 + A4988 + ARDUINO UNO
// ============================================================
// REGRA PRINCIPAL: SOMENTE UM EIXO PODE SE MOVER POR VEZ.
//
// Z:
// A1  = botao superior = limite Z- = DESCIDA
// D11 = botao inferior = limite Z+ = SUBIDA
// Botoes usam INPUT_PULLUP: livre = HIGH / pressionado = LOW.
//
// STOP interrompe qualquer movimento.
// ENABLE do A4988: LOW = habilitado / HIGH = desligado.
// Drivers desligam apos 2 s sem movimento.
//
// COMANDOS:
// PING
// MOVE X|Y|Z <passos_com_sinal> <passos/s>
// JOG_START X|Y|Z <-1|1> <passos/s>
// JOG_STOP
// STOP
// Z_DOWN <passos> <passos/s>
// Z_UP <passos> <passos/s>
// LIMITS
// POS
// ZERO [X|Y|Z]
// STATUS
// ============================================================

const unsigned long BAUD_RATE = 115200;

const uint8_t X_STEP = 2;
const uint8_t X_DIR  = 5;
const uint8_t Y_STEP = 3;
const uint8_t Y_DIR  = 6;
const uint8_t Z_STEP = 4;
const uint8_t Z_DIR  = 7;
const uint8_t ENABLE_PIN = 8;

const uint8_t Z_MINUS_BUTTON = A1; // superior
const uint8_t Z_PLUS_BUTTON  = 11; // inferior
const uint8_t BUTTON_PRESSED = LOW;

// DIRECAO FISICA DO Z.
// Nesta configuracao, Z- = DESCIDA e Z+ = SUBIDA.
// Se a mecanica estiver invertida, altere SOMENTE estas duas linhas.
const uint8_t Z_MINUS_DIR = HIGH;
const uint8_t Z_PLUS_DIR  = LOW;

const unsigned int STEP_PULSE_US = 5;
const unsigned int DIR_SETUP_US = 20;
const unsigned int ENABLE_SETTLE_MS = 2;
const unsigned long IDLE_DISABLE_MS = 2000;

const long X_MIN_STEPS = -10000;
const long X_MAX_STEPS = 10000;
const long Y_MIN_STEPS = -10000;
const long Y_MAX_STEPS = 10000;

enum MotionMode {
  IDLE,
  MOVE_MODE,
  JOG_MODE,
  Z_DOWN_MODE,
  Z_UP_MODE
};

MotionMode mode = IDLE;
char activeAxis = 'X';
int activeDirection = 1;
long remainingSteps = 0;
unsigned long activeSpeed = 500;
unsigned long lastActivity = 0;
long positionSteps[3] = {0, 0, 0};
bool driversEnabled = false;
String inputLine;

// ------------------------------------------------------------
// BOTOES
// ------------------------------------------------------------

bool zMinusPressed() {
  return digitalRead(Z_MINUS_BUTTON) == BUTTON_PRESSED;
}

bool zPlusPressed() {
  return digitalRead(Z_PLUS_BUTTON) == BUTTON_PRESSED;
}

void printLimits() {
  Serial.print(F("LIMITS TOP(A1)="));
  Serial.print(zMinusPressed() ? F("PRESSED") : F("FREE"));
  Serial.print(F(" BOTTOM(D11)="));
  Serial.print(zPlusPressed() ? F("PRESSED") : F("FREE"));
  Serial.print(F(" RAW_TOP="));
  Serial.print(digitalRead(Z_MINUS_BUTTON));
  Serial.print(F(" RAW_BOTTOM="));
  Serial.println(digitalRead(Z_PLUS_BUTTON));
}

// ------------------------------------------------------------
// PINOS / VALIDACAO
// ------------------------------------------------------------

uint8_t stepPin(char axis) {
  if (axis == 'X') return X_STEP;
  if (axis == 'Y') return Y_STEP;
  return Z_STEP;
}

uint8_t dirPin(char axis) {
  if (axis == 'X') return X_DIR;
  if (axis == 'Y') return Y_DIR;
  return Z_DIR;
}

uint8_t axisIndex(char axis) {
  if (axis == 'X') return 0;
  if (axis == 'Y') return 1;
  return 2;
}

bool validAxis(char axis) {
  return axis == 'X' || axis == 'Y' || axis == 'Z';
}

bool validSpeed(long speed) {
  return speed >= 1 && speed <= 10000;
}

// ------------------------------------------------------------
// DRIVER
// ------------------------------------------------------------

void enableDrivers() {
  lastActivity = millis();
  if (driversEnabled) return;
  digitalWrite(ENABLE_PIN, LOW);
  driversEnabled = true;
  delay(ENABLE_SETTLE_MS);
}

void disableDrivers() {
  digitalWrite(ENABLE_PIN, HIGH);
  driversEnabled = false;
}

// ------------------------------------------------------------
// DIRECAO
// ------------------------------------------------------------

void setDirection(char axis, int direction) {
  if (axis == 'Z') {
    // Z- = DESCIDA | Z+ = SUBIDA.
    digitalWrite(Z_DIR, direction < 0 ? Z_MINUS_DIR : Z_PLUS_DIR);
  } else {
    digitalWrite(dirPin(axis), direction > 0 ? HIGH : LOW);
  }
  delayMicroseconds(DIR_SETUP_US);
}

// ------------------------------------------------------------
// PASSO
// ------------------------------------------------------------

unsigned long stepInterval(unsigned long speed) {
  unsigned long interval = 1000000UL / max(1UL, speed);
  if (interval < STEP_PULSE_US + 2) interval = STEP_PULSE_US + 2;
  return interval;
}

void generateStep(char axis, unsigned long speed) {
  unsigned long interval = stepInterval(speed);
  digitalWrite(stepPin(axis), HIGH);
  delayMicroseconds(STEP_PULSE_US);
  digitalWrite(stepPin(axis), LOW);
  if (interval > STEP_PULSE_US) {
    delayMicroseconds(interval - STEP_PULSE_US);
  }
}

// ------------------------------------------------------------
// LIMITES
// ------------------------------------------------------------

bool xyLimitBlocks(char axis, int direction) {
  if (axis != 'X' && axis != 'Y') return false;

  long p = positionSteps[axisIndex(axis)];
  long minP = axis == 'X' ? X_MIN_STEPS : Y_MIN_STEPS;
  long maxP = axis == 'X' ? X_MAX_STEPS : Y_MAX_STEPS;

  if (direction < 0 && p <= minP) return true;
  if (direction > 0 && p >= maxP) return true;
  return false;
}

bool zLimitBlocks(int direction) {
  // Z- = descida = botao superior A1.
  if (direction < 0) return zMinusPressed();

  // Z+ = subida = botao inferior D11.
  return zPlusPressed();
}

bool directionBlocked(char axis, int direction) {
  if (axis == 'Z') return zLimitBlocks(direction);
  return xyLimitBlocks(axis, direction);
}

// ------------------------------------------------------------
// PARADA
// ------------------------------------------------------------

void stopMotion() {
  mode = IDLE;
  remainingSteps = 0;
  lastActivity = millis();
}

// ------------------------------------------------------------
// POSICAO
// ------------------------------------------------------------

void printPosition() {
  Serial.print(F("POS X="));
  Serial.print(positionSteps[0]);
  Serial.print(F(" Y="));
  Serial.print(positionSteps[1]);
  Serial.print(F(" Z="));
  Serial.println(positionSteps[2]);
}

void zeroAxis(char axis) {
  if (axis == 'X') positionSteps[0] = 0;
  else if (axis == 'Y') positionSteps[1] = 0;
  else if (axis == 'Z') positionSteps[2] = 0;
}

// ------------------------------------------------------------
// MOVE FINITO
// ------------------------------------------------------------

void startMove(char axis, long signedSteps, unsigned long speed) {
  if (!validAxis(axis) || signedSteps == 0 || !validSpeed(speed)) {
    Serial.println(F("ERR BAD_MOVE"));
    return;
  }

  if (mode != IDLE) {
    Serial.println(F("ERR BUSY"));
    return;
  }

  int direction = signedSteps < 0 ? -1 : 1;
  long steps = signedSteps < 0 ? -signedSteps : signedSteps;

  if (directionBlocked(axis, direction)) {
    Serial.println(F("LIMIT"));
    return;
  }

  enableDrivers();
  setDirection(axis, direction);

  activeAxis = axis;
  activeDirection = direction;
  activeSpeed = speed;
  remainingSteps = steps;
  mode = MOVE_MODE;

  Serial.println(F("ACK MOVE"));
}

// ------------------------------------------------------------
// JOG CONTINUO
// ------------------------------------------------------------

void startJog(char axis, int direction, unsigned long speed) {
  if (!validAxis(axis) || !validSpeed(speed) || (direction != -1 && direction != 1)) {
    Serial.println(F("ERR BAD_JOG"));
    return;
  }

  // Permite renovar o mesmo JOG enviado pela GUI.
  if (mode == JOG_MODE && activeAxis == axis && activeDirection == direction) {
    activeSpeed = speed;
    lastActivity = millis();
    return;
  }

  if (mode != IDLE) {
    Serial.println(F("ERR BUSY"));
    return;
  }

  if (directionBlocked(axis, direction)) {
    Serial.println(F("LIMIT"));
    return;
  }

  enableDrivers();
  setDirection(axis, direction);

  activeAxis = axis;
  activeDirection = direction;
  activeSpeed = speed;
  mode = JOG_MODE;

  Serial.println(F("ACK JOG"));
}

// ------------------------------------------------------------
// Z EXPLICITO
// ------------------------------------------------------------

void startZDown(long steps, unsigned long speed) {
  if (steps <= 0 || !validSpeed(speed)) {
    Serial.println(F("ERR BAD_Z_DOWN"));
    return;
  }
  if (mode != IDLE) {
    Serial.println(F("ERR BUSY"));
    return;
  }
  if (zMinusPressed()) {
    Serial.println(F("Z_DOWN_LIMIT"));
    return;
  }

  enableDrivers();
  setDirection('Z', -1);
  activeAxis = 'Z';
  activeDirection = -1;
  activeSpeed = speed;
  remainingSteps = steps;
  mode = Z_DOWN_MODE;
  Serial.println(F("ACK Z_DOWN"));
}

void startZUp(long steps, unsigned long speed) {
  if (steps <= 0 || !validSpeed(speed)) {
    Serial.println(F("ERR BAD_Z_UP"));
    return;
  }
  if (mode != IDLE) {
    Serial.println(F("ERR BUSY"));
    return;
  }
  if (zPlusPressed()) {
    Serial.println(F("Z_UP_LIMIT"));
    return;
  }

  enableDrivers();
  setDirection('Z', 1);
  activeAxis = 'Z';
  activeDirection = 1;
  activeSpeed = speed;
  remainingSteps = steps;
  mode = Z_UP_MODE;
  Serial.println(F("ACK Z_UP"));
}

// Compatibilidade com a GUI atual.
void startZApproach(long steps, unsigned long speed) {
  startZDown(steps, speed);
}

void startZRetract(long steps, unsigned long speed) {
  startZUp(steps, speed);
}

// ------------------------------------------------------------
// EXECUCAO
// ------------------------------------------------------------

void executeMotion() {
  if (mode == IDLE) return;

  if (directionBlocked(activeAxis, activeDirection)) {
    if (mode == JOG_MODE) {
      Serial.println(F("LIMIT"));
    } else if (mode == Z_DOWN_MODE) {
      Serial.println(F("Z_APPROACH_READY LIMIT"));
    } else if (mode == Z_UP_MODE) {
      Serial.println(F("Z_UP_LIMIT"));
    } else {
      Serial.println(F("LIMIT"));
    }
    stopMotion();
    return;
  }

  generateStep(activeAxis, activeSpeed);
  positionSteps[axisIndex(activeAxis)] += activeDirection;
  lastActivity = millis();

  if (mode == JOG_MODE) return;

  remainingSteps--;

  if (remainingSteps <= 0) {
    if (mode == Z_DOWN_MODE) {
      Serial.println(F("Z_APPROACH_READY MAX_STEPS"));
    } else if (mode == Z_UP_MODE) {
      Serial.println(F("DONE Z_UP"));
    } else {
      Serial.println(F("DONE"));
    }
    stopMotion();
  }
}

// ------------------------------------------------------------
// COMANDOS
// ------------------------------------------------------------

void handleCommand(String line) {
  line.trim();
  if (!line.length()) return;

  char buffer[100];
  line.toCharArray(buffer, sizeof(buffer));
  char* cmd = strtok(buffer, " \t");
  if (!cmd) return;

  if (!strcmp(cmd, "PING")) {
    Serial.println(F("PONG"));
    return;
  }

  if (!strcmp(cmd, "STATUS")) {
    Serial.print(F("STATUS MODE="));
    Serial.println((int)mode);
    return;
  }

  if (!strcmp(cmd, "LIMITS")) {
    printLimits();
    return;
  }

  if (!strcmp(cmd, "POS")) {
    printPosition();
    return;
  }

  if (!strcmp(cmd, "ZERO")) {
    char* a = strtok(NULL, " \t");
    if (!a) {
      positionSteps[0] = 0;
      positionSteps[1] = 0;
      positionSteps[2] = 0;
    } else if (validAxis(a[0])) {
      zeroAxis(a[0]);
    } else {
      Serial.println(F("ERR BAD_AXIS"));
      return;
    }
    Serial.println(F("OK ZERO"));
    return;
  }

  if (!strcmp(cmd, "MOVE")) {
    char* a = strtok(NULL, " \t");
    char* s = strtok(NULL, " \t");
    char* v = strtok(NULL, " \t");
    if (!a || !s || !v || !validAxis(a[0])) {
      Serial.println(F("ERR BAD_MOVE"));
      return;
    }
    startMove(a[0], atol(s), atol(v));
    return;
  }

  if (!strcmp(cmd, "JOG_START")) {
    char* a = strtok(NULL, " \t");
    char* d = strtok(NULL, " \t");
    char* v = strtok(NULL, " \t");
    if (!a || !d || !v || !validAxis(a[0])) {
      Serial.println(F("ERR BAD_JOG"));
      return;
    }
    startJog(a[0], atol(d) < 0 ? -1 : 1, atol(v));
    return;
  }

  if (!strcmp(cmd, "JOG_STOP")) {
    stopMotion();
    Serial.println(F("OK JOG_STOP"));
    return;
  }

  if (!strcmp(cmd, "STOP")) {
    stopMotion();
    Serial.println(F("OK STOP"));
    return;
  }

  if (!strcmp(cmd, "Z_DOWN")) {
    char* s = strtok(NULL, " \t");
    char* v = strtok(NULL, " \t");
    if (!s || !v) {
      Serial.println(F("ERR BAD_Z_DOWN"));
      return;
    }
    startZDown(atol(s), atol(v));
    return;
  }

  if (!strcmp(cmd, "Z_UP")) {
    char* s = strtok(NULL, " \t");
    char* v = strtok(NULL, " \t");
    if (!s || !v) {
      Serial.println(F("ERR BAD_Z_UP"));
      return;
    }
    startZUp(atol(s), atol(v));
    return;
  }

  if (!strcmp(cmd, "Z_APPROACH")) {
    char* s = strtok(NULL, " \t");
    char* v = strtok(NULL, " \t");
    char* unused = strtok(NULL, " \t");
    (void)unused;
    if (!s || !v) {
      Serial.println(F("ERR BAD_Z_APPROACH"));
      return;
    }
    startZApproach(atol(s), atol(v));
    return;
  }

  if (!strcmp(cmd, "Z_RETRACT")) {
    char* s = strtok(NULL, " \t");
    char* v = strtok(NULL, " \t");
    if (!s || !v) {
      Serial.println(F("ERR BAD_Z_RETRACT"));
      return;
    }
    startZRetract(atol(s), atol(v));
    return;
  }

  Serial.println(F("ERR UNKNOWN_COMMAND"));
}

// ------------------------------------------------------------
// SETUP / LOOP
// ------------------------------------------------------------

void setup() {
  pinMode(X_STEP, OUTPUT);
  pinMode(X_DIR, OUTPUT);
  pinMode(Y_STEP, OUTPUT);
  pinMode(Y_DIR, OUTPUT);
  pinMode(Z_STEP, OUTPUT);
  pinMode(Z_DIR, OUTPUT);
  pinMode(ENABLE_PIN, OUTPUT);

  pinMode(Z_MINUS_BUTTON, INPUT_PULLUP);
  pinMode(Z_PLUS_BUTTON, INPUT_PULLUP);

  digitalWrite(X_STEP, LOW);
  digitalWrite(Y_STEP, LOW);
  digitalWrite(Z_STEP, LOW);
  digitalWrite(ENABLE_PIN, HIGH);

  Serial.begin(BAUD_RATE);
  inputLine.reserve(96);

  Serial.println(F("READY"));
}

void loop() {
  while (Serial.available()) {
    char c = Serial.read();

    if (c == '\n' || c == '\r') {
      if (inputLine.length()) {
        handleCommand(inputLine);
        inputLine = "";
      }
    } else if (inputLine.length() < 95) {
      inputLine += c;
    }
  }

  executeMotion();

  if (mode == IDLE && driversEnabled && millis() - lastActivity >= IDLE_DISABLE_MS) {
    disableDrivers();
  }
}
