// ============================================================
// CONTROLADOR DE MOTORES - CNC SHIELD V3 + A4988 + Arduino Uno
// ============================================================
// SEGURANCA:
// - Somente UM eixo pode se mover por vez.
// - STOP cancela qualquer movimento.
// - A1 e D11 sao limites fisicos do Z.
// - Botao pressionado = LOW (INPUT_PULLUP).
// - Drivers sao desabilitados depois de 2 s parados.
//
// Z:
// A1  = botao de cima  = Z- / DESCIDA
// D11 = botao de baixo = Z+ / SUBIDA
//
// Comandos:
// MOVE X 1000 500
// MOVE Y -1000 500
// MOVE Z -1000 500
// MOVE Z 1000 500
// JOG_START Z -1 500
// JOG_START Z 1 500
// JOG_STOP
// STOP
// LIMITS
// POS
// ZERO Z
// ============================================================

const unsigned long BAUD_RATE = 115200;

const uint8_t X_STEP = 2;
const uint8_t X_DIR = 5;
const uint8_t Y_STEP = 3;
const uint8_t Y_DIR = 6;
const uint8_t Z_STEP = 4;
const uint8_t Z_DIR = 7;
const uint8_t ENABLE_PIN = 8;

const uint8_t Z_MINUS_BUTTON = A1;
const uint8_t Z_PLUS_BUTTON = 11;
const uint8_t BUTTON_PRESSED = LOW;

const unsigned int STEP_PULSE_US = 5;
const unsigned int ENABLE_SETTLE_MS = 2;
const unsigned long IDLE_DISABLE_MS = 2000;

const long X_MIN_STEPS = -10000;
const long X_MAX_STEPS = 10000;
const long Y_MIN_STEPS = -10000;
const long Y_MAX_STEPS = 10000;

// ============================================================
// DIRECAO FISICA DO Z
// ============================================================
// IMPORTANTE: os botoes NAO definem a direcao do motor.
// Eles apenas impedem o motor de continuar quando o limite
// correspondente for atingido.
//
// Se o Z estiver fisicamente invertido, alteramos somente
// estas duas constantes.
//
// Configuracao atual:
// Z- = LOW  -> DESCIDA
// Z+ = HIGH -> SUBIDA
// ============================================================
const uint8_t Z_MINUS_DIR = LOW;
const uint8_t Z_PLUS_DIR = HIGH;


enum MotionMode {
  IDLE,
  NORMAL_MOVE,
  CONTINUOUS_JOG,
  Z_APPROACH_DOWN,
  Z_RETRACT
};

MotionMode mode = IDLE;
char movingAxis = 'X';
int movingDirection = 1;
long remainingSteps = 0;
unsigned long movingSpeed = 500;
unsigned long lastActivity = 0;

long positionSteps[3] = {0, 0, 0};
bool driversEnabled = false;
String inputLine;

// ============================================================
// LEITURA DOS BOTOES
// ============================================================

bool zMinusPressed() {
  return digitalRead(Z_MINUS_BUTTON) == BUTTON_PRESSED;
}

bool zPlusPressed() {
  return digitalRead(Z_PLUS_BUTTON) == BUTTON_PRESSED;
}

// ============================================================
// PINOS
// ============================================================

uint8_t getStepPin(char axis) {
  if (axis == 'X') return X_STEP;
  if (axis == 'Y') return Y_STEP;
  return Z_STEP;
}

uint8_t getDirPin(char axis) {
  if (axis == 'X') return X_DIR;
  if (axis == 'Y') return Y_DIR;
  return Z_DIR;
}

uint8_t getAxisIndex(char axis) {
  if (axis == 'X') return 0;
  if (axis == 'Y') return 1;
  return 2;
}

bool validAxis(char axis) {
  return axis == 'X' || axis == 'Y' || axis == 'Z';
}

bool validSpeed(long speed) {
  return speed >= 1 && speed <= 10000;
}

// ============================================================
// VELOCIDADE
// ============================================================

unsigned long stepInterval(unsigned long speed) {
  unsigned long interval = 1000000UL / max(1UL, speed);

  if (interval < STEP_PULSE_US + 2) {
    interval = STEP_PULSE_US + 2;
  }

  return interval;
}

// ============================================================
// ENABLE DO A4988
// ============================================================

void enableDrivers() {
  lastActivity = millis();

  if (driversEnabled) return;

  // A4988: LOW = habilitado.
  digitalWrite(ENABLE_PIN, LOW);
  driversEnabled = true;
  delay(ENABLE_SETTLE_MS);
}

void disableDrivers() {
  // A4988: HIGH = desabilitado.
  digitalWrite(ENABLE_PIN, HIGH);
  driversEnabled = false;
}

// ============================================================
// PULSO DE STEP
// ============================================================

void generateStep(char axis, unsigned long speed) {
  unsigned long interval = stepInterval(speed);

  digitalWrite(getStepPin(axis), HIGH);
  delayMicroseconds(STEP_PULSE_US);
  digitalWrite(getStepPin(axis), LOW);

  if (interval > STEP_PULSE_US) {
    delayMicroseconds(interval - STEP_PULSE_US);
  }
}

// ============================================================
// LIMITES X/Y
// ============================================================

bool xyLimitBlocks(char axis, int direction) {
  if (axis != 'X' && axis != 'Y') return false;

  long position = positionSteps[getAxisIndex(axis)];
  long minimum = (axis == 'X') ? X_MIN_STEPS : Y_MIN_STEPS;
  long maximum = (axis == 'X') ? X_MAX_STEPS : Y_MAX_STEPS;

  if (direction < 0 && position <= minimum) return true;
  if (direction > 0 && position >= maximum) return true;

  return false;
}

// ============================================================
// LIMITES Z
// ============================================================
// Z- usa EXCLUSIVAMENTE A1.
// Z+ usa EXCLUSIVAMENTE D11.
// ============================================================

bool zLimitBlocks(int direction) {
  if (direction < 0) {
    // Z- = DESCIDA = botao de cima A1.
    return zMinusPressed();
  }

  // Z+ = SUBIDA = botao de baixo D11.
  return zPlusPressed();
}

// ============================================================
// DIRECAO DO MOTOR
// ============================================================
// A direcao do motor e decidida aqui.
// Nao depende do estado dos botoes.
// ============================================================

void setDirection(char axis, int direction) {
  if (axis == 'Z') {
    if (direction < 0) {
      // Z- = DESCIDA
      digitalWrite(Z_DIR, Z_MINUS_DIR);
    } else {
      // Z+ = SUBIDA
      digitalWrite(Z_DIR, Z_PLUS_DIR);
    }

    // Pequeno tempo para o DIR estabilizar antes do STEP.
    delayMicroseconds(10);
    return;
  }

  // X e Y mantem a logica anterior.
  digitalWrite(getDirPin(axis), direction > 0 ? HIGH : LOW);
  delayMicroseconds(10);
}

// ============================================================
// PARADA
// ============================================================

void stopMotion() {
  mode = IDLE;
  remainingSteps = 0;
  lastActivity = millis();
}

// ============================================================
// POSICAO
// ============================================================

void printPosition() {
  Serial.print(F("POS X="));
  Serial.print(positionSteps[0]);
  Serial.print(F(" Y="));
  Serial.print(positionSteps[1]);
  Serial.print(F(" Z="));
  Serial.println(positionSteps[2]);
}

void zeroAxis(char axis) {
  if (axis == 'X') positionSteps[0] = 0;
  if (axis == 'Y') positionSteps[1] = 0;
  if (axis == 'Z') positionSteps[2] = 0;
}

// ============================================================
// ESTADO DOS BOTOES
// ============================================================

void printLimits() {
  Serial.print(F("TOP A1="));
  Serial.print(zMinusPressed() ? F("PRESSED") : F("FREE"));

  Serial.print(F(" | BOTTOM D11="));
  Serial.println(zPlusPressed() ? F("PRESSED") : F("FREE"));
}

// ============================================================
// MOVE
// ============================================================

void startMove(char axis, long signedSteps, unsigned long speed) {
  if (!validAxis(axis) || signedSteps == 0 || !validSpeed(speed)) {
    Serial.println(F("ERR BAD_MOVE"));
    return;
  }

  // SEGURANCA: nunca permite dois movimentos ao mesmo tempo.
  if (mode != IDLE) {
    Serial.println(F("ERR BUSY"));
    return;
  }

  int direction = (signedSteps < 0) ? -1 : 1;
  long steps = (signedSteps < 0) ? -signedSteps : signedSteps;

  // Verifica limite ANTES de energizar/mover.
  if (axis == 'Z' && zLimitBlocks(direction)) {
    Serial.println(F("LIMIT Z"));
    return;
  }

  if (xyLimitBlocks(axis, direction)) {
    Serial.println(F("LIMIT XY"));
    return;
  }

  enableDrivers();
  setDirection(axis, direction);

  movingAxis = axis;
  movingDirection = direction;
  movingSpeed = speed;
  remainingSteps = steps;
  mode = NORMAL_MOVE;

  Serial.println(F("ACK MOVE"));
}

// ============================================================
// JOG
// ============================================================

void startJog(char axis, int direction, unsigned long speed) {
  if (!validAxis(axis) || !validSpeed(speed)) {
    Serial.println(F("ERR BAD_JOG"));
    return;
  }

  if (direction != -1 && direction != 1) {
    Serial.println(F("ERR BAD_JOG_DIR"));
    return;
  }

  // SEGURANCA: um eixo por vez.
  if (mode != IDLE) {
    Serial.println(F("ERR BUSY"));
    return;
  }

  if (axis == 'Z' && zLimitBlocks(direction)) {
    Serial.println(F("LIMIT Z"));
    return;
  }

  if (xyLimitBlocks(axis, direction)) {
    Serial.println(F("LIMIT XY"));
    return;
  }

  enableDrivers();
  setDirection(axis, direction);

  movingAxis = axis;
  movingDirection = direction;
  movingSpeed = speed;
  mode = CONTINUOUS_JOG;

  Serial.println(F("ACK JOG"));
}

// ============================================================
// ANALISE: APROXIMACAO E RETRACAO
// ============================================================

void startZApproach(long maxDownSteps, unsigned long speed, long retractSteps) {
  if (maxDownSteps <= 0 || retractSteps <= 0 || !validSpeed(speed)) {
    Serial.println(F("ERR BAD_Z_APPROACH"));
    return;
  }

  if (mode != IDLE) {
    Serial.println(F("ERR BUSY"));
    return;
  }

  // A aproximacao sempre e Z- / DESCIDA.
  if (zMinusPressed()) {
    Serial.println(F("Z_APPROACH_READY LIMIT_Z_MINUS"));
    return;
  }

  enableDrivers();
  setDirection('Z', -1);

  movingAxis = 'Z';
  movingDirection = -1;
  movingSpeed = speed;
  remainingSteps = maxDownSteps;
  mode = Z_APPROACH_DOWN;

  Serial.println(F("ACK Z_APPROACH"));
}

void startZRetract(long steps, unsigned long speed) {
  if (steps <= 0 || !validSpeed(speed)) {
    Serial.println(F("ERR BAD_Z_RETRACT"));
    return;
  }

  if (mode != IDLE) {
    Serial.println(F("ERR BUSY"));
    return;
  }

  // A retracao sempre e Z+ / SUBIDA.
  if (zPlusPressed()) {
    Serial.println(F("LIMIT Z_PLUS"));
    return;
  }

  enableDrivers();
  setDirection('Z', 1);

  movingAxis = 'Z';
  movingDirection = 1;
  movingSpeed = speed;
  remainingSteps = steps;
  mode = Z_RETRACT;

  Serial.println(F("ACK Z_RETRACT"));
}

// ============================================================
// EXECUCAO DOS MOVIMENTOS
// ============================================================

void executeMotion() {
  if (mode == IDLE) return;

  // ----------------------------------------------------------
  // JOG
  // ----------------------------------------------------------
  if (mode == CONTINUOUS_JOG) {
    // Limite e verificado antes de CADA passo.
    if ((movingAxis == 'Z' && zLimitBlocks(movingDirection)) ||
        xyLimitBlocks(movingAxis, movingDirection)) {
      stopMotion();
      Serial.println(F("LIMIT"));
      return;
    }

    generateStep(movingAxis, movingSpeed);
    positionSteps[getAxisIndex(movingAxis)] += movingDirection;
    return;
  }

  // ----------------------------------------------------------
  // MOVE / APROXIMACAO / RETRACAO
  // ----------------------------------------------------------
  if ((movingAxis == 'Z' && zLimitBlocks(movingDirection)) ||
      xyLimitBlocks(movingAxis, movingDirection)) {

    if (mode == Z_APPROACH_DOWN) {
      Serial.println(F("Z_APPROACH_READY LIMIT"));
    } else {
      Serial.println(F("LIMIT"));
    }

    stopMotion();
    return;
  }

  generateStep(movingAxis, movingSpeed);
  positionSteps[getAxisIndex(movingAxis)] += movingDirection;
  remainingSteps--;

  if (remainingSteps <= 0) {
    if (mode == Z_APPROACH_DOWN) {
      Serial.println(F("Z_APPROACH_READY MAX_STEPS"));
    } else if (mode == Z_RETRACT) {
      Serial.println(F("DONE Z_RETRACT"));
    } else {
      Serial.println(F("DONE"));
    }

    stopMotion();
  }
}

// ============================================================
// COMANDOS SERIAIS
// ============================================================

void handleCommand(String line) {
  line.trim();
  if (!line.length()) return;

  char buffer[100];
  line.toCharArray(buffer, sizeof(buffer));

  char* command = strtok(buffer, " \t");
  if (!command) return;

  if (!strcmp(command, "PING")) {
    Serial.println(F("PONG"));
    return;
  }

  if (!strcmp(command, "STATUS")) {
    Serial.print(F("STATUS MODE="));
    Serial.println((int)mode);
    return;
  }

  if (!strcmp(command, "LIMITS")) {
    printLimits();
    return;
  }

  if (!strcmp(command, "POS")) {
    printPosition();
    return;
  }

  if (!strcmp(command, "ZERO")) {
    char* axis = strtok(NULL, " \t");

    if (axis && validAxis(axis[0])) {
      zeroAxis(axis[0]);
    } else if (!axis) {
      positionSteps[0] = 0;
      positionSteps[1] = 0;
      positionSteps[2] = 0;
    } else {
      Serial.println(F("ERR BAD_AXIS"));
      return;
    }

    Serial.println(F("OK ZERO"));
    return;
  }

  if (!strcmp(command, "MOVE")) {
    char* axis = strtok(NULL, " \t");
    char* steps = strtok(NULL, " \t");
    char* speed = strtok(NULL, " \t");

    if (!axis || !steps || !speed || !validAxis(axis[0])) {
      Serial.println(F("ERR BAD_MOVE"));
      return;
    }

    startMove(axis[0], atol(steps), atol(speed));
    return;
  }

  if (!strcmp(command, "JOG_START")) {
    char* axis = strtok(NULL, " \t");
    char* direction = strtok(NULL, " \t");
    char* speed = strtok(NULL, " \t");

    if (!axis || !direction || !speed || !validAxis(axis[0])) {
      Serial.println(F("ERR BAD_JOG"));
      return;
    }

    startJog(axis[0], atol(direction) < 0 ? -1 : 1, atol(speed));
    return;
  }

  if (!strcmp(command, "JOG_STOP")) {
    if (mode == CONTINUOUS_JOG) {
      stopMotion();
    }

    Serial.println(F("OK JOG_STOP"));
    return;
  }

  // Parada de emergencia logica: cancela qualquer movimento.
  if (!strcmp(command, "STOP")) {
    stopMotion();
    Serial.println(F("OK STOP"));
    return;
  }

  if (!strcmp(command, "Z_APPROACH")) {
    char* down = strtok(NULL, " \t");
    char* speed = strtok(NULL, " \t");
    char* retract = strtok(NULL, " \t");

    if (!down || !speed || !retract) {
      Serial.println(F("ERR BAD_Z_APPROACH"));
      return;
    }

    startZApproach(atol(down), atol(speed), atol(retract));
    return;
  }

  if (!strcmp(command, "Z_RETRACT")) {
    char* steps = strtok(NULL, " \t");
    char* speed = strtok(NULL, " \t");

    if (!steps || !speed) {
      Serial.println(F("ERR BAD_Z_RETRACT"));
      return;
    }

    startZRetract(atol(steps), atol(speed));
    return;
  }

  if (!strcmp(command, "HELP")) {
    Serial.println(F("PING STATUS LIMITS POS ZERO MOVE JOG_START JOG_STOP STOP Z_APPROACH Z_RETRACT"));
    return;
  }

  Serial.println(F("ERR UNKNOWN_COMMAND"));
}

// ============================================================
// SETUP
// ============================================================

void setup() {
  pinMode(X_STEP, OUTPUT);
  pinMode(X_DIR, OUTPUT);
  pinMode(Y_STEP, OUTPUT);
  pinMode(Y_DIR, OUTPUT);
  pinMode(Z_STEP, OUTPUT);
  pinMode(Z_DIR, OUTPUT);
  pinMode(ENABLE_PIN, OUTPUT);

  // Pull-up interno:
  // livre = HIGH / pressionado = LOW.
  pinMode(Z_MINUS_BUTTON, INPUT_PULLUP);
  pinMode(Z_PLUS_BUTTON, INPUT_PULLUP);

  digitalWrite(X_STEP, LOW);
  digitalWrite(Y_STEP, LOW);
  digitalWrite(Z_STEP, LOW);

  // Comeca com os drivers desligados.
  digitalWrite(ENABLE_PIN, HIGH);
  driversEnabled = false;

  Serial.begin(BAUD_RATE);
  inputLine.reserve(96);

  Serial.println(F("READY"));
  Serial.println(F("Z- A1 = DESCIDA"));
  Serial.println(F("Z+ D11 = SUBIDA"));
}

// ============================================================
// LOOP
// ============================================================

void loop() {
  // Leitura serial nao bloqueante.
  while (Serial.available()) {
    char c = Serial.read();

    if (c == '\n' || c == '\r') {
      if (inputLine.length()) {
        handleCommand(inputLine);
        inputLine = "";
      }
    } else if (inputLine.length() < 95) {
      inputLine += c;
    }
  }

  executeMotion();

  // Reduz aquecimento: depois de 2 s parado, desabilita A4988.
  if (mode == IDLE && driversEnabled &&
      millis() - lastActivity >= IDLE_DISABLE_MS) {
    disableDrivers();
  }
}
