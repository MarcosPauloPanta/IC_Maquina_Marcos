// ============================================================
// CONTROLADOR DE MOTORES - CNC SHIELD V3 + A4988 + Arduino Uno
// ============================================================
// UM EIXO POR VEZ.
// Z- = DESCIDA | Z+ = SUBIDA.
// BOTAO DE CIMA  = A1  -> Z- (para a descida)
// BOTAO DE BAIXO = D11 -> Z+ (para a subida)
// Botoes usam INPUT_PULLUP: LIVRE = HIGH | PRESSIONADO = LOW.
// STOP interrompe qualquer movimento imediatamente.
// ============================================================

const unsigned long BAUD_RATE = 115200;

const uint8_t X_STEP = 2;
const uint8_t X_DIR = 5;
const uint8_t Y_STEP = 3;
const uint8_t Y_DIR = 6;
const uint8_t Z_STEP = 4;
const uint8_t Z_DIR = 7;
const uint8_t ENABLE_PIN = 8;

const uint8_t Z_MINUS_BUTTON = A1; // cima: Z-
const uint8_t Z_PLUS_BUTTON  = 11; // baixo: Z+
const uint8_t BUTTON_PRESSED = LOW;

const unsigned int STEP_PULSE_US = 5;
const unsigned int ENABLE_SETTLE_MS = 2;
const unsigned long IDLE_DISABLE_MS = 2000;
const long X_MIN_STEPS = -10000;
const long X_MAX_STEPS = 10000;
const long Y_MIN_STEPS = -10000;
const long Y_MAX_STEPS = 10000;

enum MotionMode {
  IDLE,
  NORMAL_MOVE,
  CONTINUOUS_JOG,
  Z_APPROACH_DOWN,
  Z_RETRACT
};

MotionMode mode = IDLE;
char moving_axis = 'X';
int moving_direction = 1;
long remaining_steps = 0;
unsigned long moving_speed_sps = 500;
unsigned long last_activity_ms = 0;
long position_steps[3] = {0, 0, 0};
bool drivers_enabled = false;
String input_line;

uint8_t stepPin(char axis) {
  if (axis == 'X') return X_STEP;
  if (axis == 'Y') return Y_STEP;
  return Z_STEP;
}

uint8_t dirPin(char axis) {
  if (axis == 'X') return X_DIR;
  if (axis == 'Y') return Y_DIR;
  return Z_DIR;
}

uint8_t axisIndex(char axis) {
  if (axis == 'X') return 0;
  if (axis == 'Y') return 1;
  return 2;
}

bool validAxis(char axis) {
  return axis == 'X' || axis == 'Y' || axis == 'Z';
}

// Botao de cima (A1) = Z-
bool zMinusPressed() {
  return digitalRead(Z_MINUS_BUTTON) == BUTTON_PRESSED;
}

// Botao de baixo (D11) = Z+
bool zPlusPressed() {
  return digitalRead(Z_PLUS_BUTTON) == BUTTON_PRESSED;
}

bool validSpeed(long speed) {
  return speed >= 1 && speed <= 10000;
}

unsigned long intervalUs(unsigned long speed) {
  unsigned long value = 1000000UL / max(1UL, speed);
  if (value < STEP_PULSE_US + 2) value = STEP_PULSE_US + 2;
  return value;
}

void enableDrivers() {
  last_activity_ms = millis();
  if (drivers_enabled) return;
  digitalWrite(ENABLE_PIN, LOW);
  drivers_enabled = true;
  delay(ENABLE_SETTLE_MS);
}

void disableDrivers() {
  digitalWrite(ENABLE_PIN, HIGH);
  drivers_enabled = false;
}

void pulseStep(char axis, unsigned long speed) {
  unsigned long interval = intervalUs(speed);
  digitalWrite(stepPin(axis), HIGH);
  delayMicroseconds(STEP_PULSE_US);
  digitalWrite(stepPin(axis), LOW);
  if (interval > STEP_PULSE_US) {
    delayMicroseconds(interval - STEP_PULSE_US);
  }
}

bool softLimitBlocks(char axis, int direction) {
  if (axis != 'X' && axis != 'Y') return false;

  long position = position_steps[axisIndex(axis)];
  long minimum = (axis == 'X') ? X_MIN_STEPS : Y_MIN_STEPS;
  long maximum = (axis == 'X') ? X_MAX_STEPS : Y_MAX_STEPS;

  return (direction < 0 && position <= minimum) ||
         (direction > 0 && position >= maximum);
}

// IMPORTANTE:
// Z- = descida e e interrompido pelo botao DE CIMA (A1).
// Z+ = subida e e interrompido pelo botao DE BAIXO (D11).
bool zLimitBlocks(int direction) {
  if (direction < 0) return zMinusPressed();
  return zPlusPressed();
}

void stopMotion() {
  mode = IDLE;
  remaining_steps = 0;
  last_activity_ms = millis();
}

void printPosition() {
  Serial.print(F("POS X="));
  Serial.print(position_steps[0]);
  Serial.print(F(" Y="));
  Serial.print(position_steps[1]);
  Serial.print(F(" Z="));
  Serial.println(position_steps[2]);
}

void printLimits() {
  Serial.print(F("BUTTON TOP(A1)="));
  Serial.print(zMinusPressed() ? F("PRESSED") : F("FREE"));
  Serial.print(F(" | BOTTOM(D11)="));
  Serial.println(zPlusPressed() ? F("PRESSED") : F("FREE"));
}

void setMotorDirection(char axis, int direction) {
  if (axis == 'Z') {
    // Configuracao fisica atual do Z.
    // Z- = LOW / descida.
    // Z+ = HIGH / subida.
    digitalWrite(Z_DIR, direction < 0 ? LOW : HIGH);
  } else {
    digitalWrite(dirPin(axis), direction > 0 ? HIGH : LOW);
  }
}

void startMove(char axis, long signedSteps, unsigned long speed) {
  if (!validAxis(axis) || signedSteps == 0 || !validSpeed((long)speed)) {
    Serial.println(F("ERR BAD_MOVE"));
    return;
  }

  if (mode != IDLE) {
    Serial.println(F("ERR BUSY"));
    return;
  }

  int direction = signedSteps > 0 ? 1 : -1;
  long steps = signedSteps > 0 ? signedSteps : -signedSteps;

  if ((axis == 'Z' && zLimitBlocks(direction)) ||
      softLimitBlocks(axis, direction)) {
    Serial.println(F("LIMIT"));
    return;
  }

  enableDrivers();
  setMotorDirection(axis, direction);

  moving_axis = axis;
  moving_direction = direction;
  moving_speed_sps = speed;
  remaining_steps = steps;
  mode = NORMAL_MOVE;

  Serial.println(F("ACK MOVE"));
}

void startJog(char axis, int direction, unsigned long speed) {
  if (!validAxis(axis) || !validSpeed((long)speed) ||
      (direction != 1 && direction != -1)) {
    Serial.println(F("ERR BAD_JOG"));
    return;
  }

  if (mode != IDLE) {
    if (mode == CONTINUOUS_JOG &&
        axis == moving_axis &&
        direction == moving_direction) {
      moving_speed_sps = speed;
      return;
    }

    Serial.println(F("ERR BUSY"));
    return;
  }

  if ((axis == 'Z' && zLimitBlocks(direction)) ||
      softLimitBlocks(axis, direction)) {
    Serial.println(F("LIMIT"));
    return;
  }

  enableDrivers();
  setMotorDirection(axis, direction);

  moving_axis = axis;
  moving_direction = direction;
  moving_speed_sps = speed;
  mode = CONTINUOUS_JOG;

  Serial.println(F("ACK JOG"));
}

void startZApproach(long downSteps, unsigned long speed, long retractSteps) {
  if (downSteps <= 0 || retractSteps <= 0 || !validSpeed((long)speed)) {
    Serial.println(F("ERR BAD_Z_APPROACH"));
    return;
  }

  if (mode != IDLE) {
    Serial.println(F("ERR BUSY"));
    return;
  }

  // Z- = descida -> A1 e o limite da descida.
  if (zMinusPressed()) {
    Serial.println(F("Z_APPROACH_READY LIMIT_TOP"));
    return;
  }

  enableDrivers();
  setMotorDirection('Z', -1);
  moving_axis = 'Z';
  moving_direction = -1;
  moving_speed_sps = speed;
  remaining_steps = downSteps;
  mode = Z_APPROACH_DOWN;

  Serial.println(F("ACK Z_APPROACH"));
}

void startZRetract(long steps, unsigned long speed) {
  if (steps <= 0 || !validSpeed((long)speed)) {
    Serial.println(F("ERR BAD_Z_RETRACT"));
    return;
  }

  if (mode != IDLE) {
    Serial.println(F("ERR BUSY"));
    return;
  }

  // Z+ = subida -> D11 e o limite da subida.
  if (zPlusPressed()) {
    Serial.println(F("LIMIT Z_PLUS"));
    return;
  }

  enableDrivers();
  setMotorDirection('Z', 1);
  moving_axis = 'Z';
  moving_direction = 1;
  moving_speed_sps = speed;
  remaining_steps = steps;
  mode = Z_RETRACT;

  Serial.println(F("ACK Z_RETRACT"));
}

void executeMotion() {
  if (mode == IDLE) return;

  // ----------------------------------------------------------
  // JOG CONTINUO
  // A parada e feita pelo comando JOG_STOP enviado pela GUI.
  // ----------------------------------------------------------
  if (mode == CONTINUOUS_JOG) {
    if ((moving_axis == 'Z' && zLimitBlocks(moving_direction)) ||
        softLimitBlocks(moving_axis, moving_direction)) {
      stopMotion();
      Serial.println(F("LIMIT"));
      return;
    }

    pulseStep(moving_axis, moving_speed_sps);
    position_steps[axisIndex(moving_axis)] += moving_direction;
    return;
  }

  // ----------------------------------------------------------
  // MOVE / ANALISE / Z
  // ----------------------------------------------------------
  if ((moving_axis == 'Z' && zLimitBlocks(moving_direction)) ||
      softLimitBlocks(moving_axis, moving_direction)) {

    if (mode == Z_APPROACH_DOWN) {
      Serial.println(F("Z_APPROACH_READY LIMIT"));
    } else {
      Serial.println(F("LIMIT"));
    }

    stopMotion();
    return;
  }

  pulseStep(moving_axis, moving_speed_sps);
  position_steps[axisIndex(moving_axis)] += moving_direction;
  remaining_steps--;

  if (remaining_steps <= 0) {
    if (mode == Z_APPROACH_DOWN) {
      Serial.println(F("Z_APPROACH_READY MAX_STEPS"));
    } else if (mode == Z_RETRACT) {
      Serial.println(F("DONE Z_RETRACT"));
    } else {
      Serial.println(F("DONE"));
    }

    stopMotion();
  }
}

void zeroAxis(char axis) {
  if (axis == 'X') position_steps[0] = 0;
  else if (axis == 'Y') position_steps[1] = 0;
  else if (axis == 'Z') position_steps[2] = 0;
}

void handleCommand(String line) {
  line.trim();
  if (!line.length()) return;

  char buffer[100];
  line.toCharArray(buffer, sizeof(buffer));

  char* command = strtok(buffer, " \t");
  if (!command) return;

  if (!strcmp(command, "PING")) {
    Serial.println(F("PONG"));
    return;
  }

  if (!strcmp(command, "STATUS")) {
    Serial.print(F("STATUS MODE="));
    Serial.println((int)mode);
    return;
  }

  if (!strcmp(command, "LIMITS")) {
    printLimits();
    return;
  }

  if (!strcmp(command, "POS")) {
    printPosition();
    return;
  }

  if (!strcmp(command, "ZERO")) {
    char* axis = strtok(NULL, " \t");

    if (axis && validAxis(axis[0])) {
      zeroAxis(axis[0]);
    } else if (!axis) {
      position_steps[0] = 0;
      position_steps[1] = 0;
      position_steps[2] = 0;
    } else {
      Serial.println(F("ERR BAD_AXIS"));
      return;
    }

    Serial.println(F("OK ZERO"));
    return;
  }

  if (!strcmp(command, "MOVE")) {
    char* axis = strtok(NULL, " \t");
    char* steps = strtok(NULL, " \t");
    char* speed = strtok(NULL, " \t");

    if (!axis || !steps || !speed || !validAxis(axis[0])) {
      Serial.println(F("ERR BAD_MOVE"));
      return;
    }

    startMove(axis[0], atol(steps), atol(speed));
    return;
  }

  if (!strcmp(command, "JOG_START")) {
    char* axis = strtok(NULL, " \t");
    char* direction = strtok(NULL, " \t");
    char* speed = strtok(NULL, " \t");

    if (!axis || !direction || !speed || !validAxis(axis[0])) {
      Serial.println(F("ERR BAD_JOG"));
      return;
    }

    startJog(axis[0], atol(direction) >= 0 ? 1 : -1, atol(speed));
    return;
  }

  if (!strcmp(command, "JOG_STOP")) {
    if (mode == CONTINUOUS_JOG) stopMotion();
    Serial.println(F("OK JOG_STOP"));
    return;
  }

  // Parada geral: cancela MOVE, JOG, aproximacao e retracao.
  if (!strcmp(command, "STOP")) {
    stopMotion();
    Serial.println(F("OK STOP"));
    return;
  }

  if (!strcmp(command, "Z_APPROACH")) {
    char* down = strtok(NULL, " \t");
    char* speed = strtok(NULL, " \t");
    char* retract = strtok(NULL, " \t");

    if (!down || !speed || !retract) {
      Serial.println(F("ERR BAD_Z_APPROACH"));
      return;
    }

    startZApproach(atol(down), atol(speed), atol(retract));
    return;
  }

  if (!strcmp(command, "Z_RETRACT")) {
    char* steps = strtok(NULL, " \t");
    char* speed = strtok(NULL, " \t");

    if (!steps || !speed) {
      Serial.println(F("ERR BAD_Z_RETRACT"));
      return;
    }

    startZRetract(atol(steps), atol(speed));
    return;
  }

  if (!strcmp(command, "HELP")) {
    Serial.println(F("PING STATUS LIMITS POS ZERO MOVE JOG_START JOG_STOP STOP Z_APPROACH Z_RETRACT"));
    return;
  }

  Serial.println(F("ERR UNKNOWN_COMMAND"));
}

void setup() {
  pinMode(X_STEP, OUTPUT);
  pinMode(X_DIR, OUTPUT);
  pinMode(Y_STEP, OUTPUT);
  pinMode(Y_DIR, OUTPUT);
  pinMode(Z_STEP, OUTPUT);
  pinMode(Z_DIR, OUTPUT);
  pinMode(ENABLE_PIN, OUTPUT);

  // Pull-up interno: botao solto = HIGH, pressionado = LOW.
  pinMode(Z_MINUS_BUTTON, INPUT_PULLUP);
  pinMode(Z_PLUS_BUTTON, INPUT_PULLUP);

  digitalWrite(X_STEP, LOW);
  digitalWrite(Y_STEP, LOW);
  digitalWrite(Z_STEP, LOW);
  digitalWrite(ENABLE_PIN, HIGH);

  Serial.begin(BAUD_RATE);
  input_line.reserve(96);

  Serial.println(F("READY"));
  Serial.println(F("BUTTONS A1=Z- TOP | D11=Z+ BOTTOM"));
}

void loop() {
  while (Serial.available()) {
    char c = Serial.read();

    if (c == '\n' || c == '\r') {
      if (input_line.length()) {
        handleCommand(input_line);
        input_line = "";
      }
    } else if (input_line.length() < 95) {
      input_line += c;
    }
  }

  executeMotion();

  if (mode == IDLE &&
      drivers_enabled &&
      millis() - last_activity_ms >= IDLE_DISABLE_MS) {
    disableDrivers();
  }
}
